# Fiaba — variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# En local (supabase start), les valeurs par défaut fonctionnent.
#
# Pour Vercel : ajoutez ces variables dans Project Settings > Environment Variables.
# Les variables VITE_* sont exposées côté client (build time).

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
